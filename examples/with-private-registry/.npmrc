# Sample .npmrc for the with-private-registry example.
# Documents how to wire guroku v0.5 up to a private/corporate registry.

# Public-default fallback. Comment out if you want EVERY fetch routed through corp.
registry=https://registry.npmjs.org

# Per-scope routing: anything under @acme goes to the corp registry.
@acme:registry=https://npm.acme.internal

# Bearer-token auth for the corp registry. Replace with a real token.
# Hint: most registries expose a tokens UI; copy from there.
# DO NOT commit a real token to git.
//npm.acme.internal/:_authToken=REPLACE_ME_WITH_A_REAL_TOKEN
